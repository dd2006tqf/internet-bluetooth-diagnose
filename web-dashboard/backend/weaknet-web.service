[Unit]
Description=WeakNet Web Visualization Dashboard Gateway
After=weaknet-server.service network.target
Wants=weaknet-server.service

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/weaknet/web/backend
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
Environment=PYTHONPATH=/home/radxa/weaknet/web/backend:/home/radxa/weaknet/client/lib
Environment=LD_LIBRARY_PATH=/home/radxa/weaknet/client/lib:/usr/local/lib
Environment=WEAKNET_DATA_DIR=/home/radxa/weaknet/data

[Install]
WantedBy=multi-user.target
