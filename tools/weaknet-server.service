[Unit]
Description=WeakNet Network Monitor Server
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/radxa/weaknet/server
ExecStart=/home/radxa/weaknet/server/bin/weaknet-dbus-server --config /etc/weaknet/config.yaml
Restart=on-failure
RestartSec=5
Environment=LD_LIBRARY_PATH=/usr/local/lib
Environment=WEAKNET_DATA_DIR=/home/radxa/weaknet/data
User=root
Group=root
# eBPF 探针加载/挂载需要 CAP_BPF + CAP_PERFMON（内核 5.8+），
# 网络诊断（ping raw socket / netlink）需要 CAP_NET_RAW + CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_BPF CAP_PERFMON
NoNewPrivileges=false
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
