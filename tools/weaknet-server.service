[Unit]
Description=WeakNet Network Monitor Server
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/radxa/weaknet/server
ExecStart=/home/radxa/weaknet/server/bin/weaknet-dbus-server
Restart=on-failure
RestartSec=5
Environment=LD_LIBRARY_PATH=/usr/local/lib
Environment=WEAKNET_DATA_DIR=/home/radxa/weaknet/data
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
User=radxa
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
