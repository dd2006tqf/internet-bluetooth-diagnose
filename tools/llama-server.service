[Unit]
Description=Llama.cpp Local LLM Inference Server (Qwen2.5-0.5B)
After=network.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/llama
ExecStart=/home/radxa/llama/bin/llama-server -m /home/radxa/llama/models/qwen2.5-0.5b-instruct-q4_k_m.gguf --host 127.0.0.1 --port 8080 -c 1024 -t 4 --log-disable
Restart=on-failure
RestartSec=3s
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
