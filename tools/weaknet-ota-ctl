def cmd_status(args, root, state_dir):
    state = load_state(state_dir)
    tx = tx_of(state)
    payload = {
        "schema_version": state["schema_version"],
        "revision": state["revision"],
        "stable_version": state.get("stable_version"),
        "previous_stable_version": state.get("previous_stable_version"),
        "current": read_current(root),
        "phase": tx["phase"] if tx else None,
        "transaction_id": tx["transaction_id"] if tx else None,
        "release_count": len(list_versions(root)),
    }
    if tx:
        payload.update({
            "kind": tx.get("kind"),
            "from_version": tx.get("from_version"),
            "to_version": tx.get("to_version"),
            "rollback_target": tx.get("rollback_target"),
            "boot_attempts": tx.get("boot_attempts"),
            "last_error": tx.get("last_error"),
            # 同版本重装时旧副本被 RENAME_EXCHANGE 换到 staging 路径，
            # 调用方（升级脚本）靠它定位待清理的旧内容。
            "previous_staged": tx.get("previous_staged", ""),
            "materialized": tx.get("materialized", False),
        })
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    return EXIT_OK


def cmd_begin(args, root, state_dir):
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        tx = tx_of(state)
        if tx and tx["phase"] not in TERMINAL_PHASES:
            raise ConflictError("已有进行中的事务（%s），拒绝开始新事务" % tx["phase"])
        if tx:
            archive_transaction(state_dir, state)

        to_ver = check_version(args.to_version, "--to")
        from_ver = check_version(args.from_version, "--from")
        rollback_to = check_version(args.rollback_target, "--rollback-target")
        # 目标目录可以尚不存在——apply 流程里它由 materialize 从 staging 落位。
        # 但必须给出 --staged 证明调用方手上有一个已校验的目录，否则就是
        # 「指向一个不存在的版本」，必须拒绝。
        if not release_exists(root, to_ver):
            if not args.staged:
                raise OtaError(
                    "目标版本不存在：releases/%s（若是首次落位请用 --staged 指定已校验的目录）"
                    % to_ver, EXIT_USAGE)
            if not os.path.isdir(args.staged):
                raise OtaError("--staged 目录不存在：%s" % args.staged, EXIT_USAGE)
        if not release_exists(root, rollback_to) and rollback_to != to_ver:
            raise OtaError("回滚目标不存在：releases/%s" % rollback_to, EXIT_USAGE)
        # 失败候选不得成为回滚目标。唯一例外是**同版本幂等重装**
        # （from == to）：此时"回滚"不是换版本，而是把同版本目录内容恢复成
        # 升级前的旧副本，版本号前后一致，不构成"失败版本转正"。
        if rollback_to == to_ver and from_ver != to_ver:
            raise OtaError("回滚目标不能等于目标版本（失败版本不得成为稳定版本）", EXIT_USAGE)

        tx_new = new_transaction(
            args.kind, from_ver, to_ver, rollback_to,
            _previous_stable_before(args, state), _parse_policy(args.policy))
        tx_new["staged_path"] = os.path.abspath(args.staged) if args.staged else ""
        tx_new["materialized"] = not args.staged
        state["transaction"] = tx_new
        save_state(state_dir, state)
        print(json.dumps({"ok": True, "phase": PHASE_PREPARED,
                          "transaction_id": state["transaction"]["transaction_id"]},
                         ensure_ascii=False))
    return EXIT_OK


def cmd_materialize(args, root, state_dir):
    """把 staging 目录落到 releases/<to_version>（PREPARED 阶段）。

    这一步**不改指针**，所以对跨版本升级是安全的：崩溃后 current 仍指旧版，
    reconcile 直接 abort 即可。

    但同版本幂等重装例外——目标目录已存在，落位等于替换内容，而这正是
    current 指向的目录。所以必须用 RENAME_EXCHANGE 原子交换，绝不能
    「先挪走再挪进」（两步之间目录缺失，此时掉电服务直接起不来）。
    """
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_PREPARED)
        tx = state["transaction"]

        if tx.get("materialized"):
            print(json.dumps({"ok": True, "materialized": False,
                              "note": "已经落位过（幂等）"}, ensure_ascii=False))
            return EXIT_OK

        staged = tx.get("staged_path") or ""
        if not staged or not os.path.isdir(staged):
            raise OtaError("staging 目录不存在：%r" % staged, EXIT_USAGE)

        # materialize_release 内含 RENAME_EXCHANGE 的"支持就用、不支持就拒绝"
        # 判定，这里不再重复实现一遍（两处实现必然漂移）。
        _swapped, previous_in_staged = materialize_release(root, tx["to_version"], staged)
        if previous_in_staged:
            tx["previous_staged"] = previous_in_staged

        tx["materialized"] = True
        tx["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        save_state(state_dir, state)
        print(json.dumps({"ok": True, "materialized": True,
                          "previous_staged": tx.get("previous_staged", "")},
                         ensure_ascii=False))
    return EXIT_OK



def _parse_policy(raw):
    if not raw:
        return {}
    try:
        return json.loads(raw)
    except ValueError as exc:
        raise OtaError("--policy 不是合法 JSON：%s" % exc, EXIT_USAGE)


def _previous_stable_before(args, state):
    """本事务开始前的"上一稳定版本"。

    显式传值优先；未传则沿用状态里已有的 previous_stable_version。
    必须显式回落到状态值：调用方（升级脚本）一旦漏传，回滚结束时
    rolled-back 会把 previous 写成 None，把"上一稳定版"这个事实丢掉——
    演练里就是这么暴露出来的。
    """
    if args.previous_stable_before:
        return check_version(args.previous_stable_before, "--previous-stable-before")
    return state.get("previous_stable_version")


def cmd_arm_switch(args, root, state_dir):
    """PREPARED -> SWITCH_PENDING：先把切换意图落盘，之后才允许翻指针。"""
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_PREPARED)
        tx = state["transaction"]
        cur = read_current(root)
        # 首次安装例外：设备还没有 current 软链（cur is None），此时
        # from_version == to_version == 目标版本，"指针必须等于原版本"的前提
        # 不成立——因为根本没有原版本。允许推进。
        if cur is None and tx["from_version"] == tx["to_version"]:
            set_phase(state, PHASE_SWITCH_PENDING)
            save_state(state_dir, state)
            print(json.dumps({"ok": True, "phase": PHASE_SWITCH_PENDING}, ensure_ascii=False))
            return EXIT_OK
        if cur != tx["from_version"]:
            raise ConflictError("PREPARED 阶段 current 已非原版本，拒绝推进")
        set_phase(state, PHASE_SWITCH_PENDING)
        save_state(state_dir, state)
        print(json.dumps({"ok": True, "phase": PHASE_SWITCH_PENDING}, ensure_ascii=False))
    return EXIT_OK


def cmd_do_switch(args, root, state_dir):
    """SWITCH_PENDING -> 翻转 current -> TRIAL。幂等。"""
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_SWITCH_PENDING, PHASE_TRIAL)
        tx = state["transaction"]
        flipped = switch_current(root, tx["to_version"])
        warnings = refresh_compat_links(root)
        if tx["phase"] == PHASE_SWITCH_PENDING:
            set_phase(state, PHASE_TRIAL)
            save_state(state_dir, state)
        print(json.dumps({"ok": True, "phase": tx["phase"], "flipped": flipped,
                          "warnings": warnings}, ensure_ascii=False))
    return EXIT_OK


def cmd_commit(args, root, state_dir):
    """TRIAL -> COMMITTED（或 --forced 时 FORCED_COMMITTED）。

    稳定版本元数据与 phase 在**同一次写入**中更新，避免出现
    「phase=COMMITTED 但 stable_version 还是旧的」的中间态。
    """
    forced = args.forced
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        if forced:
            require_tx(state, PHASE_TRIAL, PHASE_PREPARED, PHASE_SWITCH_PENDING)
        else:
            require_tx(state, PHASE_TRIAL)
        tx = state["transaction"]

        cur = read_current(root)
        if cur != tx["to_version"]:
            raise ConflictError(
                "提交时 current=%r 与候选版本 %s 不符，拒绝提交" % (cur, tx["to_version"]))

        # 同一次 save 里完成：phase + stable/previous 元数据
        #
        # 同版本幂等重装（from == to）时**不改** previous：那一笔的"上一稳定
        # 版本"就是它自己，把它写成 previous 会让 .previous == current，
        # 之后的无参回滚会因"目标与当前相同"而失败——那是一条死路。
        if tx["from_version"] != tx["to_version"]:
            state["previous_stable_version"] = tx["from_version"]
        state["stable_version"] = tx["to_version"]
        set_phase(state, PHASE_FORCED_COMMITTED if forced else PHASE_COMMITTED)
        save_state(state_dir, state)

        warnings = project_views(root, state)
        print(json.dumps({"ok": True, "phase": state["transaction"]["phase"],
                          "stable_version": state["stable_version"],
                          "previous_stable_version": state["previous_stable_version"],
                          "warnings": warnings}, ensure_ascii=False))
    return EXIT_OK


def cmd_abort(args, root, state_dir):
    """PREPARED / SWITCH_PENDING -> ABORTED（不触碰稳定版本）。"""
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_PREPARED, PHASE_SWITCH_PENDING)
        tx = state["transaction"]
        cur = read_current(root)
        if cur != tx["from_version"]:
            raise ConflictError(
                "中止要求 current 仍为原版本 %s，实际 %r" % (tx["from_version"], cur))
        set_phase(state, PHASE_ABORTED, error=args.reason or "aborted")
        save_state(state_dir, state)
        project_views(root, state)
        print(json.dumps({"ok": True, "phase": PHASE_ABORTED}, ensure_ascii=False))
    return EXIT_OK


def cmd_rollback_arm(args, root, state_dir):
    """TRIAL / SWITCH_PENDING -> ROLLBACK_PENDING：先记意图，再翻指针。"""
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_TRIAL, PHASE_SWITCH_PENDING)
        tx = state["transaction"]
        if tx["rollback_target"] == tx["to_version"]:
            raise ConflictError("回滚目标等于候选版本，状态非法")
        set_phase(state, PHASE_ROLLBACK_PENDING, error=args.reason or "rollback requested")
        save_state(state_dir, state)
        print(json.dumps({"ok": True, "phase": PHASE_ROLLBACK_PENDING,
                          "rollback_target": tx["rollback_target"]}, ensure_ascii=False))
    return EXIT_OK


def cmd_rollback_do(args, root, state_dir):
    """ROLLBACK_PENDING -> 翻回 rollback_target -> ROLLBACK_VERIFY。幂等。"""
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_ROLLBACK_PENDING, PHASE_ROLLBACK_VERIFY)
        tx = state["transaction"]
        flipped = switch_current(root, tx["rollback_target"])
        warnings = refresh_compat_links(root)
        if tx["phase"] == PHASE_ROLLBACK_PENDING:
            set_phase(state, PHASE_ROLLBACK_VERIFY)
            save_state(state_dir, state)
        print(json.dumps({"ok": True, "phase": tx["phase"], "flipped": flipped,
                          "warnings": warnings}, ensure_ascii=False))
    return EXIT_OK


def cmd_rolled_back(args, root, state_dir):
    """ROLLBACK_VERIFY -> ROLLED_BACK（旧版已验证健康）。

    关键：**绝不**把失败候选写进 previous_stable —— 失败版本不得因为回滚
    动作而重新获得稳定版本身份。
    """
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_ROLLBACK_VERIFY)
        tx = state["transaction"]
        if read_current(root) != tx["rollback_target"]:
            raise ConflictError("回滚目标未就位，拒绝标记 ROLLED_BACK")

        state["stable_version"] = tx["rollback_target"]
        state["previous_stable_version"] = tx["previous_stable_before"]
        set_phase(state, PHASE_ROLLED_BACK)
        save_state(state_dir, state)
        project_views(root, state)
        print(json.dumps({"ok": True, "phase": PHASE_ROLLED_BACK,
                          "stable_version": state["stable_version"],
                          "previous_stable_version": state["previous_stable_version"]},
                         ensure_ascii=False))
    return EXIT_OK


def cmd_require_recovery(args, root, state_dir):
    """任意非终态 -> RECOVERY_REQUIRED（停止一切自动动作）。"""
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        tx = tx_of(state)
        if tx is None:
            raise ConflictError("没有进行中的事务")
        if tx["phase"] == PHASE_RECOVERY_REQUIRED:
            print(json.dumps({"ok": True, "phase": PHASE_RECOVERY_REQUIRED,
                              "note": "已是 RECOVERY_REQUIRED"}, ensure_ascii=False))
            return EXIT_OK
        set_phase(state, PHASE_RECOVERY_REQUIRED, error=args.reason or "recovery required")
        save_state(state_dir, state)
        print(json.dumps({"ok": True, "phase": PHASE_RECOVERY_REQUIRED}, ensure_ascii=False))
    return EXIT_OK


def cmd_recover(args, root, state_dir):
    """RECOVERY_REQUIRED 的人工退出通道。

    运维修复现场后必须显式指定一个可信版本（--accept）或显式放弃（--abort），
    不允许"自动恢复"——那样会把未验证的猜测写回权威状态。
    """
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        tx = tx_of(state)
        if tx is None or tx["phase"] != PHASE_RECOVERY_REQUIRED:
            raise ConflictError("当前不处于 RECOVERY_REQUIRED")

        if args.abort:
            set_phase(state, PHASE_ABORTED, error="manual abort from recovery")
            save_state(state_dir, state)
            project_views(root, state)
            print(json.dumps({"ok": True, "phase": PHASE_ABORTED}, ensure_ascii=False))
            return EXIT_OK

        if not args.accept:
            raise OtaError("必须指定 --accept <version> 或 --abort", EXIT_USAGE)

        accepted = check_version(args.accept, "--accept")
        if not release_exists(root, accepted):
            raise OtaError("指定版本不存在：releases/%s" % accepted, EXIT_USAGE)

        switch_current(root, accepted)
        warnings = refresh_compat_links(root)
        state["stable_version"] = accepted
        # 上一稳定版本：优先用事务记录里的 previous_stable_before。
        # 它为 None 时**不能**把 None 写回去——那会丢掉"上一稳定版本"这个
        # 事实，设备就少了一条自动退路。此时回落到状态里已有的值。
        prev = tx.get("previous_stable_before")
        if prev is None:
            prev = state.get("previous_stable_version")
        if prev == accepted:
            prev = None
        state["previous_stable_version"] = prev
        state["stable_source"] = "manual"
        state["previous_source"] = "manual" if prev else "unknown"
        set_phase(state, PHASE_COMMITTED, error="manual recovery accepted %s" % accepted)
        save_state(state_dir, state)
        warnings += project_views(root, state)
        print(json.dumps({"ok": True, "phase": PHASE_COMMITTED,
                          "stable_version": accepted,
                          "previous_stable_version": prev,
                          "warnings": warnings},
                         ensure_ascii=False))
    return EXIT_OK


def cmd_reconcile(args, root, state_dir):
    state = load_state(state_dir)
    verdict = reconcile(root, state)
    if args.dry_run:
        verdict["dry_run"] = True
        print(json.dumps(verdict, ensure_ascii=False, indent=2, sort_keys=True))
        return EXIT_RECOVERY if verdict["action"] == "recovery_required" else EXIT_OK

    # 非 dry-run：只执行 reconcile 判定为安全的自动动作
    action = verdict["action"]
    if action in ("none", "recovery_required"):
        print(json.dumps(verdict, ensure_ascii=False, indent=2, sort_keys=True))
        return EXIT_RECOVERY if action == "recovery_required" else EXIT_OK

    argv = [sys.executable, os.path.abspath(__file__)]
    argv += ["--root", root, "--state-dir", state_dir]
    if action == "abort":
        argv += ["abort", "--reason", verdict["reason"]]
    elif action == "mark_trial":
        argv += ["do-switch"]
    elif action == "project_views":
        argv += ["project-views"]
    else:
        # continue_trial / continue_rollback 需要健康判定，属 P0-B 职责
        print(json.dumps(verdict, ensure_ascii=False, indent=2, sort_keys=True))
        return EXIT_OK
    os.execv(sys.executable, argv)


def cmd_project_views(args, root, state_dir):
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        warnings = project_views(root, state)
        print(json.dumps({"ok": True, "warnings": warnings}, ensure_ascii=False))
    return EXIT_OK


def cmd_gc(args, root, state_dir):
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        removed, skip_reason = collect_garbage(root, state, args.max_keep)
        print(json.dumps({"ok": True, "removed": removed, "skipped": skip_reason},
                         ensure_ascii=False))
    return EXIT_OK


def cmd_bootstrap(args, root, state_dir):
    """老设备首次接管：建立 schema v1 记录并记录推断来源。

    推断规则（按证据强度排序，**证据不足时明确返回未知，不猜**）：

    1. **事务历史**（最可信）：`history/` 里归档的终态事务写下了每笔升级
       实际做了什么。人工回滚之后，它与「目录上还带着 .committed」的事实
       会分叉——只有历史能区分。
    2. **current 软链**（确认当前稳定版本）：必须存在且带 `.committed`。
    3. **.committed 的时间顺序**（次优）：仅当没有任何历史可用时使用。
    4. **人工指定**：`--accept-stable` / `--accept-previous`。

    每个推断出的值都带一个 source 标记（写进状态文件），便于审计。
    """
    with ExclusiveLock(state_dir):
        if os.path.exists(state_path(state_dir)) and not args.force:
            raise ConflictError("事务状态已存在，bootstrap 拒绝覆盖（需 --force）")

        cur = read_current(root)
        if cur is None:
            raise OtaError("current 软链不存在或形态异常，无法自动推断稳定版本", EXIT_USAGE)

        marker = os.path.join(release_dir(root, cur), ".committed")
        cur_committed = os.path.exists(marker)
        if not cur_committed and not args.accept_stable:
            raise OtaError(
                "current=%s 缺少 .committed，无法确认它是已转正版本；"
                "请人工确认后用 --accept-stable <version>" % cur, EXIT_RECOVERY)

        # ---- 1. 事务历史优先 ----
        h_stable, h_previous, h_source = infer_from_history(state_dir, root, cur)

        if h_stable is not None:
            stable, stable_src = h_stable, h_source
            previous, previous_src = h_previous, (h_source if h_previous else "unknown")
        else:
            # ---- 2. 回落到 current 软链 ----
            stable = cur
            stable_src = "current" if cur_committed else "manual"

            # ---- 3. 上一稳定版本：没有历史时用 .committed 的时间顺序 ----
            previous, previous_src = _infer_previous_by_marker_time(root, cur)

        # ---- 4. 人工指定覆盖 ----
        if args.accept_stable:
            stable = check_version(args.accept_stable, "--accept-stable")
            stable_src = "manual"
        if args.accept_previous:
            previous = check_version(args.accept_previous, "--accept-previous")
            previous_src = "manual"
        if previous is not None and previous == stable:
            # 上一稳定版本等于当前稳定版本 = 没有退路。宁可明确未知。
            previous, previous_src = None, "unknown"

        state = empty_state()
        state["stable_version"] = stable
        state["stable_source"] = stable_src
        state["previous_stable_version"] = previous
        state["previous_source"] = previous_src

        if args.dry_run:
            print(json.dumps({"dry_run": True, "stable_version": stable,
                              "stable_source": stable_src,
                              "previous_stable_version": previous,
                              "previous_source": previous_src,
                              "current": read_current(root)},
                             ensure_ascii=False, indent=2))
            return EXIT_OK

        save_state(state_dir, state)
        warnings = project_views(root, state)
        print(json.dumps({"ok": True, "stable_version": stable,
                          "stable_source": stable_src,
                          "previous_stable_version": previous,
                          "previous_source": previous_src,
                          "warnings": warnings},
                         ensure_ascii=False))
    return EXIT_OK


def _infer_previous_by_marker_time(root, cur):
    """没有事务历史时的次优推断：按 .committed 的 mtime 找最近的已转正版本。

    比"版本号最高"更接近事实：人工回滚之后，1.2.0 目录仍带 .committed
    （它确实转正过），但它是**先**转正的，mtime 更早；而当前版本不会被
    "重新确认"（.committed 不重写），所以排除 current 之后 mtime 最新的
    那个已转正版本就是最可能的上一稳定版。

    仍然不是铁证：mtime 会被 rsync / tar 之类的操作改写。所以它的 source
    标为 "committed_mtime"，与 "transaction_history" 明确区分。

    找不到带 .committed 的其他版本时，最后才用旧布局的 `.previous` 文件
    兜底（source = "previous_file"）。那个文件的语义是「上一次操作之前的
    版本」，与「上一稳定版本」不完全等价，所以只当最后手段，且必须校验
    它指向的版本确实存在且不等于 current。

    返回 (previous, source)；证据不足返回 (None, "unknown")。
    """
    candidates = []
    for name in list_versions(root):
        if name == cur:
            continue
        path = os.path.join(release_dir(root, name), ".committed")
        if not os.path.exists(path):
            continue
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            continue
        candidates.append((mtime, name))
    if candidates:
        candidates.sort()
        return candidates[-1][1], "committed_mtime"

    # 最后手段：旧布局的 .previous 文件
    prev_file = os.path.join(root, "releases", ".previous")
    if os.path.exists(prev_file):
        try:
            with open(prev_file, "r", encoding="utf-8") as fh:
                candidate = fh.read().strip()
        except IOError:
            return None, "unknown"
        if (VERSION_RE.match(candidate) and candidate != cur
                and release_exists(root, candidate)):
            return candidate, "previous_file"
    return None, "unknown"


def cmd_bump_boot_attempt(args, root, state_dir):
    """P0-B 用：每次**实际启动试运行前**先原子加一，防止断电无限重试。

    必须在启动之前调用——先启动再计数的话，掉电会漏计。

    **按 boot_id 幂等**：同一次开机内重复调用不重复计数。理由是恢复
    服务本身也可能被 systemd 重启（它退出会请求重启自己），那不是一次新的
    设备启动，不该消耗一次试运行机会。只有**设备真的重启过**（boot_id 变
    了）才算新的一次尝试。
    """
    with ExclusiveLock(state_dir):
        state = load_state(state_dir)
        require_tx(state, PHASE_TRIAL)
        tx = state["transaction"]
        boot_id = args.boot_id or ""
        if boot_id and tx.get("last_trial_boot_id") == boot_id:
            # 本次开机已计过数
            print(json.dumps({"ok": True, "boot_attempts": tx["boot_attempts"],
                              "note": "本次开机已计数（幂等）"}, ensure_ascii=False))
            return EXIT_OK
        tx["boot_attempts"] = int(tx["boot_attempts"]) + 1
        if boot_id:
            tx["last_trial_boot_id"] = boot_id
        save_state(state_dir, state)
        print(json.dumps({"ok": True, "boot_attempts": tx["boot_attempts"]},
                         ensure_ascii=False))
    return EXIT_OK


