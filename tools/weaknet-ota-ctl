def build_parser():
    parser = argparse.ArgumentParser(
        prog="weaknet-ota-ctl",
        description="WeakNet OTA 升级事务控制器（P0-A）：唯一的版本指针与事务状态写入口")
    parser.add_argument("--root", default=None, help="weaknet 安装根（默认 $WEAKNET_ROOT 或 /home/radxa/weaknet）")
    parser.add_argument("--state-dir", default=None, help="事务状态目录（默认 /var/lib/weaknet-ota）")

    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="输出当前状态（JSON）")

    p = sub.add_parser("begin", help="开始一笔事务（PREPARED）")
    p.add_argument("--kind", default="upgrade", choices=["upgrade", "manual_rollback"])
    p.add_argument("--from", dest="from_version", required=True)
    p.add_argument("--to", dest="to_version", required=True)
    p.add_argument("--rollback-target", required=True)
    p.add_argument("--previous-stable-before", default=None)
    p.add_argument("--policy", default=None, help="JSON 字符串，快照保存")
    p.add_argument("--staged", default=None,
                   help="已校验的 staging 目录（目标版本尚未落位时必填）")

    sub.add_parser("materialize", help="PREPARED：把 staging 落到 releases/<to>（不改指针）")

    sub.add_parser("arm-switch", help="PREPARED -> SWITCH_PENDING（落盘切换意图）")
    sub.add_parser("do-switch", help="SWITCH_PENDING -> 翻 current -> TRIAL（幂等）")

    p = sub.add_parser("commit", help="TRIAL -> COMMITTED")
    p.add_argument("--forced", action="store_true",
                   help="跳过健康验证直接提交（对应 --commit），落 FORCED_COMMITTED")

    p = sub.add_parser("abort", help="PREPARED/SWITCH_PENDING -> ABORTED")
    p.add_argument("--reason", default=None)

    p = sub.add_parser("rollback-arm", help="TRIAL/SWITCH_PENDING -> ROLLBACK_PENDING")
    p.add_argument("--reason", default=None)
    sub.add_parser("rollback-do", help="ROLLBACK_PENDING -> 翻回 -> ROLLBACK_VERIFY（幂等）")
    sub.add_parser("rolled-back", help="ROLLBACK_VERIFY -> ROLLED_BACK")

    p = sub.add_parser("require-recovery", help="进入 RECOVERY_REQUIRED（停止自动动作）")
    p.add_argument("--reason", default=None)

    p = sub.add_parser("recover", help="人工退出 RECOVERY_REQUIRED")
    p.add_argument("--accept", default=None, help="认定该版本为稳定版本并切到它")
    p.add_argument("--abort", action="store_true", help="放弃本事务")

    p = sub.add_parser("reconcile", help="按持久事实判定下一步")
    p.add_argument("--dry-run", action="store_true", help="只输出判定，不执行")

    sub.add_parser("project-views", help="重建 .committed / .previous 兼容视图")

    p = sub.add_parser("gc", help="保守回收历史版本")
    p.add_argument("--max-keep", type=int, default=3)

    p = sub.add_parser("bootstrap", help="老设备首次接管")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--force", action="store_true")
    p.add_argument("--accept-stable", default=None)
    p.add_argument("--accept-previous", default=None,
                   help="人工指定上一稳定版本（无事务历史时使用）")

    p = sub.add_parser("bump-boot-attempt", help="P0-B：启动试运行前先加一")
    p.add_argument("--boot-id", default=None)

    return parser


HANDLERS = {
    "status": cmd_status,
    "begin": cmd_begin,
    "materialize": cmd_materialize,
    "arm-switch": cmd_arm_switch,
    "do-switch": cmd_do_switch,
    "commit": cmd_commit,
    "abort": cmd_abort,
    "rollback-arm": cmd_rollback_arm,
    "rollback-do": cmd_rollback_do,
    "rolled-back": cmd_rolled_back,
    "require-recovery": cmd_require_recovery,
    "recover": cmd_recover,
    "reconcile": cmd_reconcile,
    "project-views": cmd_project_views,
    "gc": cmd_gc,
    "bootstrap": cmd_bootstrap,
    "bump-boot-attempt": cmd_bump_boot_attempt,
}


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    root, state_dir = resolve_paths(args.root, args.state_dir)
    try:
        return HANDLERS[args.command](args, root, state_dir)
    except OtaError as exc:
        sys.stderr.write("weaknet-ota-ctl: %s\n" % exc)
        return exc.code


if __name__ == "__main__":
    sys.exit(main())
