CLEANUP_SCRIPT = r'''
import json, sqlite3, sys
payload = json.loads(PAYLOAD_JSON)
out = {"ok": False, "deleted": 0}
try:
    conn = sqlite3.connect(payload["db"], timeout=10)
    conn.execute("PRAGMA busy_timeout = 10000")
except Exception as exc:
    print(json.dumps({"ok": False, "error": "open: %s" % exc})); sys.exit(0)
try:
    # 只删本工具写的：event_id 前缀是唯一判据。
    # 刻意不级联删 site_incident_events：那条回链是关联器写的证据，删掉会让
    # 已产出的事故失去可追溯性。留着它，靠 event_id 前缀仍能查出证据来源。
    cur = conn.execute(
        "DELETE FROM device_events WHERE event_id LIKE 'forge_%'")
    conn.commit()
    out["deleted"] = cur.rowcount if cur.rowcount and cur.rowcount > 0 else 0
    out["ok"] = True
except Exception as exc:
    out["error"] = "delete: %s" % exc
finally:
    conn.close()
print(json.dumps(out))
'''


# ============================================================================
# 构造事件
# ============================================================================
def _mac_for(index):
    """生成一个明确属于本地管理地址段的假 MAC。

    为什么用 02 开头：IEEE 规定首字节第 2 个最低位为 1 表示本地管理地址。
    真实厂商设备永远不会用这个段，因此构造出来的设备地址在语义上就与真实设备
    不冲突——即便有人把构造数据误当成真实采集，MAC 段本身就是提示。
    """
    return "02:00:00:00:00:%02X" % (index & 0xFF)


def build_rows(devices, now_ms, site_id, gateway_id):
    """构造 N 台设备的合格异常事件。

    为什么混合两种事件类型：LINK_DISCONNECTED（原因 CONNECTION_TIMEOUT）与
    LINK_DEGRADED 都是合格异常，混合写入能同时覆盖 qualify() 的两条分支。
    只写一种的话，另一条分支的判定逻辑就从未被这个工具打中过。

    为什么交替用 BREDR 与 LE_PUBLIC：deviceKeyOf() 把 address_type 纳入身份，
    同一 MAC 的 BREDR 与 LE 是两个不同设备。交替使用能验证「身份复合键真的按
    protocol 加 address_type 区分」，而不是只看 MAC 字符串。
    """
    rows = []
    base = now_ms - EVENT_BACKDATE_MS
    for i in range(devices):
        is_degraded = (i % 2 == 1)
        ts = base + i * DEVICE_SPREAD_MS
        event_id = "%s_%d_%d" % (FORGE_EVENT_PREFIX, now_ms, i)
        address_type = ADDRESS_TYPE_LE_PUBLIC if i % 3 == 2 else ADDRESS_TYPE_BREDR
        if is_degraded:
            event_type = EVENT_TYPE_LINK_DEGRADED
            reason = REASON_OTHER
            source = SOURCE_KERNEL_HCI
        else:
            event_type = EVENT_TYPE_LINK_DISCONNECTED
            reason = REASON_CONNECTION_TIMEOUT
            source = SOURCE_KERNEL_HCI_TIMEOUT
        details = json.dumps({
            "raw_evidence": [{
                "source": source,
                "source_detail": FORGE_SOURCE_DETAIL,
                "note": "synthesized by weaknet-incident-forge",
            }]
        }, ensure_ascii=False)
        rows.append([
            event_id, ts, site_id, gateway_id, PROTOCOL_BLUETOOTH,
            _mac_for(i + 1), address_type, 0, event_type,
            None,                    # rssi_at_event_dbm：未采集写 NULL 而非 0
            0, reason, source, FORGE_SOURCE_DETAIL,
            None,                    # suspected_cause：采集层不做诊断，恒 NULL
            details,
        ])
    return rows


# ============================================================================
# 远端片段调用
# ============================================================================
def _parse_last_json(text, what):
    for line in reversed(text.strip().splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            return json.loads(line)
        except ValueError:
            continue
    raise SystemExit("[forge] %s的输出无法解析：%s" % (what, text[:400]))


def do_probe(runner, db_path):
    code, out, err = runner.run_script(PROBE_SCRIPT, {"db": db_path})
    if code != 0:
        raise SystemExit("[forge] 探测数据库失败（rc=%s）：%s" % (code, err.strip()))
    return _parse_last_json(out, "探测")


def do_insert(runner, db_path, rows):
    # elevate=True：WAL 配套文件（-wal/-shm）属主是 root，普通用户写不进去。
    code, out, err = runner.run_script(
        INSERT_SCRIPT, {"db": db_path, "rows": rows}, timeout=60, elevate=True)
    if code != 0:
        raise SystemExit("[forge] 写入失败（rc=%s）：%s" % (code, err.strip()))
    return _parse_last_json(out, "写入")


def do_query(runner, db_path, since_ms):
    code, out, err = runner.run_script(
        QUERY_SCRIPT, {"db": db_path, "since_ms": since_ms}, timeout=60)
    if code != 0:
        raise SystemExit("[forge] 查询事故失败（rc=%s）：%s" % (code, err.strip()))
    return _parse_last_json(out, "查询")


def do_cleanup(runner, db_path):
    # 同 do_insert：DELETE 也是写事务，必须与 -wal/-shm 的属主同身份。
    code, out, err = runner.run_script(
        CLEANUP_SCRIPT, {"db": db_path}, timeout=60, elevate=True)
    if code != 0:
        raise SystemExit("[forge] 清理失败（rc=%s）：%s" % (code, err.strip()))
    return _parse_last_json(out, "清理")


