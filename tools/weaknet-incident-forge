def local_has_db(db_path):
    return os.path.exists(db_path)


def detect_remote(args):
    """自动判断该不该走 ssh。

    判据是「本机有没有那个数据库」。云端开发机上没有，说明必须远端执行；
    板子上有，说明是本地执行。这样默认行为在两种场景下都正确，不需要用户每次
    手动加 --local。
    """
    if args.local:
        return False
    return not local_has_db(args.db)


def main(argv):
    parser = argparse.ArgumentParser(
        prog="weaknet-incident-forge",
        description="命令行构造一次区域级事故（SiteIncident），用于留证链路回归",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "示例：\n"
            "  %(prog)s --dry-run\n"
            "  %(prog)s --apply --watch\n"
            "  %(prog)s --cleanup\n"
        ),
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true",
                      help="只报告将写入什么，不碰数据库（默认）")
    mode.add_argument("--apply", action="store_true",
                      help="实际写入事件并重启插件")
    mode.add_argument("--cleanup", action="store_true",
                      help="删除本工具构造过的事件")
    parser.add_argument("--devices", type=int, default=DEFAULT_DEVICES,
                        help="构造几台设备（默认 %d）" % DEFAULT_DEVICES)
    parser.add_argument("--cooldown", type=int, default=DEFAULT_COOLDOWN_S,
                        help="等待事故出现的秒数（默认 %d）" % DEFAULT_COOLDOWN_S)
    parser.add_argument("--watch", action="store_true",
                        help="构造后持续打印事故与留证流转")
    parser.add_argument("--watch-seconds", type=int, default=180,
                        help="--watch 的总观察时长（默认 180 秒）")
    parser.add_argument("--db", default=DEFAULT_DB, help="history.db 路径")
    parser.add_argument("--cli", default=DEFAULT_CLI, help="weaknet-cli 路径")
    parser.add_argument("--monitor", default=DEFAULT_MONITOR,
                        help="要重启的插件名（默认 %s）" % DEFAULT_MONITOR)
    parser.add_argument("--site-id", default="", help="site_id（默认与网关一致）")
    parser.add_argument("--gateway-id", default="", help="gateway_id（默认自动推导）")
    parser.add_argument("--local", action="store_true",
                        help="强制在本机执行，不加 ssh 前缀")
    parser.add_argument("--board", default="board", help="ssh 别名（默认 board）")
    parser.add_argument("--check-schema", action="store_true",
                        help="只校验数据库 schema 与枚举值，不做任何写入")
    args = parser.parse_args(argv)

    # 默认行为是干跑：这是刻意的。一个能写事件表的工具，绝不能因为「没写参数」
    # 就产生副作用。
    if not (args.apply or args.cleanup or args.check_schema):
        args.dry_run = True

    if args.devices < 1:
        raise SystemExit("[forge] --devices 必须不小于 1")
    if args.devices > 64:
        raise SystemExit("[forge] --devices 上限 64（再多也只是一次事故）")

    remote = detect_remote(args)
    runner = Runner(remote=remote, board_alias=args.board)
    where = "远端(%s)" % args.board if remote else "本机"
    print("[forge] 执行位置：%s，数据库：%s" % (where, args.db))

    # ---- schema 探测 ---------------------------------------------------
    probe = do_probe(runner, args.db)
    if not probe.get("ok"):
        print("[forge] 探测失败：%s" % probe.get("error", "unknown"))
        return 2
    if not probe.get("has_events_table"):
        print("[forge] device_events 表不存在——服务从未启动过或数据库不对")
        return 2
    missing = REQUIRED_COLUMNS - set(probe.get("columns", []))
    if missing:
        print("[forge] device_events 缺少列：%s" % sorted(missing))
        print("[forge] schema 与预期不符，拒绝写入（盲写会产出关联器读不懂的行）")
        return 2

    thresholds, read_ok = read_thresholds(runner, args.cli)
    src = "运行时配置" if read_ok else "生产默认值（读取失败）"
    print("[forge] 阈值（%s）：最少 %d 台设备、比例门槛 %.1f%%、"
          "关联窗口 %dms、静默期 %dms"
          % (src, thresholds["min_devices"], thresholds["min_ratio_bp"] / 100.0,
             thresholds["window_ms"], thresholds["quiet_ms"]))

    if args.check_schema:
        print("[forge] schema 校验通过")
        print("[forge] 现有事件 %s 条，其中构造事件 %s 条；事故 %s 起"
              % (probe.get("event_count"), probe.get("forge_event_count"),
                 probe.get("incident_count")))
        return 0

    # ---- 清理模式 ------------------------------------------------------
    if args.cleanup:
        res = do_cleanup(runner, args.db)
        if not res.get("ok"):
            print("[forge] 清理失败：%s" % res.get("error", "unknown"))
            return 2
        print("[forge] 已删除构造事件 %s 条" % res.get("deleted", 0))
        print("[forge] 注意：已产出的事故行与其证据回链刻意保留——"
              "它们是关联器的产出，删掉会让证据链断掉")
        return 0

    # ---- 阈值可达性预判 ------------------------------------------------
    # 这一层是预判而非判定：真判定在关联器里。但如果连预判都不达标，写进去也是
    # 白写，不如直接告诉用户要加几台设备。
    if args.devices < thresholds["min_devices"]:
        print("[forge] 设备数 %d 低于绝对门槛 %d，本次必然开不出事故"
              % (args.devices, thresholds["min_devices"]))
        print("[forge] 请加 --devices %d 或更多" % thresholds["min_devices"])
        return 1

    now_ms = int(time.time() * 1000)
    # ---- 结案下限预检 --------------------------------------------------
    # 回放左边界 = max(回放窗口左沿, 最近一次 resolved_at_ms)。一旦上一轮事故
    # 已结案，其 resolved_at_ms 会越过本轮事件时刻，回放就把它们全部跳过，
    # 表现为「写进去了但事故没出现」。撞上就拒绝，并给出还要等多久。
    latest_resolved = int(probe.get("latest_resolved_at") or 0)
    event_ts = now_ms - EVENT_BACKDATE_MS
    if latest_resolved > 0 and latest_resolved >= event_ts:
        wait_s = (latest_resolved - event_ts) // 1000 + 2
        print("[forge] 撞上结案下限：最近一次事故结案于 %d，"
              "而本轮事件时刻是 %d" % (latest_resolved, event_ts))
        print("[forge] 回放会跳过全部早于 %d 的事件，本轮必然读不到。"
              % latest_resolved)
        print("[forge] 请等待约 %d 秒后重跑，或用 --cleanup 清掉构造事件"
              % wait_s)
        return 4

    gateway_id = args.gateway_id or "radxa-cubie-a7a"
    site_id = args.site_id or gateway_id
    rows = build_rows(args.devices, now_ms, site_id, gateway_id)

    if args.dry_run:
        print("[forge] 干跑：将写入 %d 条合格异常事件" % len(rows))
        print("[forge]   时间基准 ts=%d（现在 -8s）" % event_ts)
        print("[forge]   site_id=%s gateway_id=%s" % (site_id, gateway_id))
        for row in rows[:6]:
            print("[forge]   event_id=%s ts=%d type=%s reason=%s addr=%s/%s source=%s"
                  % (row[0], row[1], row[8], row[11], row[5], row[6], row[12]))
        if len(rows) > 6:
            print("[forge]   …… 其余 %d 条同构" % (len(rows) - 6))
        print("[forge] 干跑结束，未写入任何数据。加 --apply 实际执行。")
        return 0

    # ---- 实际写入 ------------------------------------------------------
    print("[forge] 写入 %d 条合格异常事件 …" % len(rows))
    res = do_insert(runner, args.db, rows)
    if not res.get("ok"):
        print("[forge] 写入失败：%s" % res.get("error", "unknown"))
        return 2
    print("[forge] 写入完成：新增 %s 条，已存在跳过 %s 条"
          % (res.get("inserted", 0), res.get("skipped", 0)))

    # ---- 重启插件以触发回放 --------------------------------------------
    # 必须重启：运行中的关联器不会去读库。recoverFromStore 只在插件 start()
    # 里执行一次，这是生产既有的重启回放语义（不是为测试开的洞）。
    print("[forge] 重启插件 %s 以触发回放 …" % args.monitor)
    rc, out = restart_monitor(runner, args.cli, args.monitor)
    if rc != 0:
        print("[forge] 插件重启失败（rc=%d）：%s" % (rc, out))
        print("[forge] 事件已写入，但未回放——可手动执行：")
        print("[forge]   sudo %s monitor restart %s" % (args.cli, args.monitor))
        return 3
    tail = out.splitlines()[-1] if out else "ok"
    print("[forge] 插件已重启：%s" % tail)

    # ---- 等待事故出现 --------------------------------------------------
    print("[forge] 等待事故出现（最多 %ds）…" % args.cooldown)
    incident = None
    deadline = time.time() + args.cooldown
    while time.time() < deadline:
        time.sleep(3)
        snapshot = do_query(runner, args.db, event_ts)
        if snapshot.get("incidents"):
            incident = snapshot["incidents"][0]
            break

    if not incident:
        print("[forge] %ds 内未出现事故，退出码 3" % args.cooldown)
        print("[forge] 可能原因：")
        print("  1. 回放窗口已过——事件写得太早，或插件重启太慢；重跑即可")
        print("  2. 活跃分母被真实设备拉大，比例门槛未达；加 --devices")
        print("  3. 插件重启失败但 rc=0（查看 journalctl -u weaknet-server）")
        return 3

    print("[forge] 事故已开出：%s" % incident["incident_id"])
    print("[forge]   受影响设备 %s 台，状态 %s"
          % (incident["affected_devices"], incident["state"]))
    print("[forge]   started_at_ms=%s" % incident["started_at_ms"])
    print("[forge] 巡检线程每 2 秒轮询一次；留证需要预录窗口内有 IDR，"
          "通常 10 到 30 秒内开始录制")

    if not args.watch:
        return 0

    # ---- 观察留证流转 --------------------------------------------------
    #
    # 观察点必须放在**云端**：板端没有 video_clips 表，片段记录只落云端。
    # 早先版本在板端查表，于是每条成功上传都被报成失败——把最该被看见的
    # 成功当成了失败，比不报更糟。
    cloud_base = read_cloud_base(runner, args.cli)
    if cloud_base:
        print("[forge] 云端观察点：%s（设备 %s）" % (cloud_base, gateway_id))
    else:
        print("[forge] 读不到 edge.url，只能观察板端事故，留证成果无法核对")
    print("[forge] 观察留证流转（%ds）…" % args.watch_seconds)

    seen = {}
    end = time.time() + args.watch_seconds
    while time.time() < end:
        time.sleep(5)
        clips = fetch_cloud_clips(cloud_base, gateway_id, incident["incident_id"])
        for clip in clips or []:
            cid = clip.get("clip_id")
            state = clip.get("state")
            if seen.get(cid) == state:
                continue
            seen[cid] = state
            print("[forge]   片段 %s state=%s 分片 %s/%s 字节 %s"
                  % (cid, state, clip.get("received_chunks"),
                     clip.get("expected_chunks"), clip.get("total_bytes")))

    if not seen:
        print("[forge] 云端未收到本次事故的留证片段")
        print("[forge] 本次仍证明「事故被正确开出」；留证落空需查两处：")
        print("[forge]   板端 sudo journalctl -u weaknet-server | grep 留证")
        print("[forge]   云端是否可达：curl %s/assets/%s/video-clips"
              % (cloud_base or "<cloud>", gateway_id))
        return 0

    # 逐段核对：sha256 一致 + NAL 结构完整。两者缺一都不能说「可解码」。
    print("[forge] 核对片段载荷 …")
    bad = 0
    for cid, state in seen.items():
        if state != "COMPLETE":
            print("[forge]   %s 仍是 %s，跳过载荷核对" % (cid, state))
            continue
        data = fetch_cloud_clip_bytes(cloud_base, gateway_id, cid)
        if data is None:
            print("[forge]   %s 下载失败" % cid)
            bad += 1
            continue
        digest = hashlib.sha256(data).hexdigest()
        want = ""
        for clip in fetch_cloud_clips(cloud_base, gateway_id,
                                      incident["incident_id"]) or []:
            if clip.get("clip_id") == cid:
                want = clip.get("declared_content_sha256") or ""
                break
        sum_ok = (not want) or (digest == want)
        print("[forge]   %s bytes=%d sha256=%s（%s）"
              % (cid, len(data), digest[:16],
                 "与清单一致" if sum_ok else "与清单不一致"))
        # 载荷形态有且只有两种可能：板端封装成功是 MP4，封装失败降级是裸
        # Annex-B。两种都要能判，否则任一种形态都会被误报成失败。
        if looks_like_mp4(data):
            mp4 = describe_mp4_layout(data)
            decodable = mp4["has_ftyp"] and mp4["has_moov"] and mp4["has_mdat"]
            print("[forge]     MP4 容器，顶层 box：%s（moov=%s mdat=%s）"
                  % (" ".join(mp4["boxes"]) or "(空)",
                     mp4["has_moov"], mp4["has_mdat"]))
        else:
            nal = describe_nal_layout(data)
            decodable = nal["has_sps"] and nal["has_pps"] and nal["has_idr"]
            print("[forge]     裸 Annex-B（板端未封装），NAL 单元 %d，"
                  "SPS=%s PPS=%s IDR=%d，首个 NAL 是 SPS=%s"
                  % (nal["units"], nal["has_sps"], nal["has_pps"],
                     nal["idr_count"], nal["starts_with_sps"]))
        if not (sum_ok and decodable):
            bad += 1

    if bad:
        print("[forge] 留证链路走通但载荷核对未全通过（%d 段）" % bad)
        return 5
    print("[forge] 留证链路完整：事故 → 录制 → 上传 → 云端落库 → 载荷可解码")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("\n[forge] 已中断")
        sys.exit(130)
