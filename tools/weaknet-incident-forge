def read_thresholds(runner, cli):
    """从 weaknet-cli 读运行时阈值，用于预判本次构造能否达标。

    这一步是诊断辅助，不是判定依据：真正的判定仍然发生在关联器里。读不到就按
    生产默认值提示，绝不因为读不到就中断——工具的核心价值是构造事实。
    """
    defaults = {
        "min_devices": 2, "min_ratio_bp": 3000,
        "window_ms": 60000, "quiet_ms": 60000, "active_ms": 60000,
    }
    code, out, _ = runner.run([cli, "get", "bluetooth"], timeout=30)
    if code != 0:
        return defaults, False
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            blob = json.loads(line)
        except ValueError:
            continue
        bt = blob.get("bluetooth")
        if not isinstance(bt, dict):
            continue
        def pick(key, default):
            try:
                return int(bt.get(key, default))
            except (TypeError, ValueError):
                return default
        return {
            "min_devices": pick("incident_min_devices", 2),
            "min_ratio_bp": pick("incident_min_ratio_bp", 3000),
            "window_ms": pick("incident_window_ms", 60000),
            "quiet_ms": pick("incident_quiet_window_ms", 60000),
            "active_ms": pick("incident_active_window_ms", 60000),
        }, True
    return defaults, False


def read_cloud_base(runner, cli):
    """从 edge.url 反推云端根地址，用于查询留证是否真的落地。

    为什么不复用 VideoClipExporter::deriveClipsUrl 的那条规则（只认
    `/edge/telemetry` 结尾）：那是**发送**侧的约束，要严到「猜错就不发」。
    本工具是**观察**侧，目标是尽量把已有的事实读出来，宁可读不到也不该因为
    地址形态不标准就拒绝观察。因此这里只做最小限度的推导：拿 url 的主机端口
    部分，再拼上固定的 API 前缀。读不到就返回空串，watch 会退化成只报板端。
    """
    code, out, _ = runner.run([cli, "get", "edge"], timeout=30)
    if code != 0:
        return ""
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            blob = json.loads(line)
        except ValueError:
            continue
        edge = blob.get("edge")
        if not isinstance(edge, dict):
            continue
        url = str(edge.get("url") or "")
        marker = "/api/"
        idx = url.find(marker)
        if idx <= 0:
            return ""
        return url[:idx] + "/api/v1/network"
    return ""


def fetch_cloud_clips(base, device_id, incident_id, timeout=10):
    """查云端已收的留证片段摘要（只读，无鉴权写操作）。

    为什么要查云端而不是板端：板端根本没有 video_clips 表——片段记录只在云端
    落库，板端只在内存队列里短暂存在。早先版本在板端查表，于是每条成功的上传
    都会被报成「未观察到留证片段」，把最该被看见的成功当成了失败。
    """
    if not base or not device_id:
        return None
    url = "%s/assets/%s/video-clips?limit=50" % (base, device_id)
    if incident_id:
        url += "&incident_id=" + incident_id
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            payload = resp.read()
    except (urllib.error.URLError, OSError, ValueError):
        return None
    try:
        data = json.loads(payload)
    except ValueError:
        return None
    return data if isinstance(data, list) else None


def fetch_cloud_clip_bytes(base, device_id, clip_id, timeout=30):
    """下载已拼装的码流，用于核对 sha256 与 NAL 结构。"""
    url = "%s/assets/%s/video-clips/%s/content" % (base, device_id, clip_id)
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return resp.read()
    except (urllib.error.URLError, OSError, ValueError):
        return None


def looks_like_mp4(data):
    """判断字节是否是 MP4 容器。

    判据是 ISO/IEC 14496-12 规定的第一个 box 类型 `ftyp`，落在 `[4, 8)`。
    为什么不能看扩展名或清单字段：容器是码流自身的事实。板端封装是**尽力而为**
    （缺 ffmpeg 或码流不合规时降级传裸流），云端历史片段又全是裸流，
    所以同一个下载端点的字节既可能是 MP4 也可能是 Annex-B——只能按字节判。
    """
    return len(data) >= 12 and data[4:8] == b"ftyp"


def describe_mp4_layout(data):
    """列出顶层 box，回答「这个 MP4 结构是否完整」。

    为什么值得做：`ftyp` 只能证明「开头像 MP4」。真正决定它能不能播的是
    `moov`（索引）与 `mdat`（码流数据）是否都在。封装被截断时会留下一个
    只有 `ftyp`+`mdat` 的半截文件，播放器打不开，而 sha256 依然与清单一致
    ——校验和只证明「云端存的字节就是板端发的字节」，不证明那串字节可用。
    """
    boxes = []
    i = 0
    while i + 8 <= len(data) and len(boxes) < 64:
        size = int.from_bytes(data[i:i + 4], "big")
        kind = data[i + 4:i + 8]
        try:
            name = kind.decode("ascii")
        except UnicodeDecodeError:
            name = kind.hex()
        boxes.append(name)
        if size < 8:
            break
        i += size
    return {
        "boxes": boxes,
        "has_moov": "moov" in boxes,
        "has_mdat": "mdat" in boxes,
        "has_ftyp": "ftyp" in boxes,
    }


def describe_nal_layout(data):
    """统计 Annex-B NAL 类型，回答「这段码流能不能解码」。

    为什么值得做：sha256 一致只证明「云端存的字节和板端发的一致」，
    完全不证明那些字节是一段可解码的视频。缺少 SPS/PPS/IDR 的码流可以
    完美通过校验和，却解不出任何画面——这正是留证链路最需要排除的失败。
    """
    types = {}
    order = []
    i = 0
    while True:
        j = data.find(b"\x00\x00\x01", i)
        if j < 0:
            break
        start = j + 3
        i = start
        if start >= len(data):
            break
        t = data[start] & 0x1F
        types[t] = types.get(t, 0) + 1
        if len(order) < 8:
            order.append(t)
    return {
        "units": sum(types.values()),
        "has_sps": types.get(7, 0) > 0,
        "has_pps": types.get(8, 0) > 0,
        "has_idr": types.get(5, 0) > 0,
        "idr_count": types.get(5, 0),
        "starts_with_sps": bool(order) and order[0] == 7,
    }


def restart_monitor(runner, cli, monitor):
    """重启插件，触发 recoverFromStore 回放。

    这是本工具唯一的副作用动作。它之所以安全：monitor restart 走的是生产既有
    的 D-Bus 生命周期接口，与运维手动重启插件完全同一条路径。

    必须带 sudo：D-Bus 侧对 restart 做了 root 校验（requireRootCaller），
    普通用户调用会被直接拒绝，且拒绝发生在回放之前——表现为「什么都没发生」。
    """
    code, out, err = runner.run(["sudo", "-n", cli, "monitor", "restart", monitor],
                               timeout=90)
    return code, (out + err).strip()


