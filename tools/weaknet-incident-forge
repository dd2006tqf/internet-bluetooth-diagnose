#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""weaknet-incident-forge — 命令行构造一次区域级事故（SiteIncident）

为什么需要这个程序
==================

区域事故的触发门槛是产品定义写死的：同一现场至少 2 台设备在关联窗口内同时
出现合格异常，且受影响比例达标。这是「一台设备坏了」与「这一片无线环境出了
问题」的分界线，不能为了测试通过就调低它。

后果是：单网关、周边设备稀少的现场永远凑不出一次真实事故。而留证链路
（事故 → 回溯预录 → 切片 → 签名分片上传 → 云端入库）的价值全在事故真的
发生那一刻。没有事故，那条链路在单测之外从未被完整走过一遍——第一次运行就是
真出事那次，等于从未拥有过这个能力。

本工具解决的是这个可测性问题：用一条命令构造出合格的事故条件，让整条留证
链路可以按需、可重复、可回归地跑通。

关键设计：不注入内存态，只构造事实
==================================

最省事的做法是往关联器对象里直接塞一个 SiteIncident。本工具刻意不那么做。

理由是「什么算事故」这段语义恰恰是留证链路最不可替代的部分：注入内存态绕过
了 QualifyingAnomalyPolicy::qualify() 与双门槛判定，验完仍然不知道生产代码
会不会自己开出一场事故。

因此本工具的做法是：

  1. 往 device_events 表写入 N 条合格异常（真实 schema、真实枚举字符串）
  2. 通过 D-Bus 重启 bt_events 插件
  3. 插件 start() 里的 recoverFromStore() 按生产逻辑回放这些事件，
     用 observeLocked() 重新推导事故，双门槛照常判定
  4. 巡检线程每 2 秒轮询活跃事故 → 请求留证 → 编码器回溯预录 → 上传

也就是说：除了事件来源是构造的，判定、聚合、持久化、触发留证每一步都是生产
代码。工具本身不含任何判定逻辑，它只是往事实表里写事实。

三条必须守住的边界
==================

不伪造已有事故：只写 device_events，绝不写 site_incidents 或
site_incident_events。事故行只能由关联器自己产出，否则证据链断裂。

不改生产阈值：不读也不写 incident_min_devices 等配置。门槛不够就多造几台
设备，绝不放松判定标准。

事件可甄别：所有构造事件的 event_id 带 forge 前缀、source_detail 标为
INCIDENT_FORGE。任何人查库都能一眼分清哪些是构造的、哪些是真实采集的。

两个会让构造静默失效的坑（本工具已内置防护）
============================================

坑一，回放窗口。recoverFromStore 只回放 ts 落在
[now - (关联窗口 + 静默窗口), now] 的事件。默认各 60 秒，即必须落在最近
120 秒内。构造事件写「现在 - 8 秒」，既有余量又不像未来。

坑二，结案下限。回放左边界是
max(回放窗口左沿, 该现场最近一次 resolved_at_ms)。上一轮构造的事故结案后
（resolved_at_ms 约等于其最后事件加 60 秒），任何早于该时刻的新事件都会被
跳过，表现为「写进去了但回放读到 0 条」。本工具写入前读这个下限，撞上就拒绝
执行并提示还要等多少秒——绝不硬写一版注定被忽略的数据。

用法
====

  # 干跑：只报告将写入什么，不碰数据库（默认行为）
  ./tools/weaknet-incident-forge --dry-run

  # 构造一次事故（默认 3 台设备）
  ./tools/weaknet-incident-forge --apply

  # 构造后等待并打印事故与留证片段的流转
  ./tools/weaknet-incident-forge --apply --watch

  # 指定设备数（必须不低于生产绝对门槛）
  ./tools/weaknet-incident-forge --apply --devices 4

  # 清掉本工具构造过的事件（只删自己写的，绝不碰真实采集）
  ./tools/weaknet-incident-forge --cleanup

  # 只看数据库 schema 与枚举自检，不做任何写入
  ./tools/weaknet-incident-forge --check-schema

在云端开发机（板子通过反向隧道接入）上运行时，本工具自动检测并给所有命令加
ssh board 前缀；--local 可强制在本机执行。

注意：**不要**用 sudo 运行本工具本身。两句提醒：

  1. 需要 root 的三步（写库、清理、重启插件）由工具在远端自行加 sudo -n，
     不需要外层再套一层。外层 sudo 不会让它做得更对，只会改变执行身份。
  2. 在云端开发机上外层 sudo 会**直接把它跑坏**：ssh 会改用 root 的
     known_hosts 与密钥，`ssh board` 别名随即失效，报的却是
     「Host key verification failed」——看起来像板子掉线，实际是身份被换了。

因此写库必须提权这一点在工具内部解决，调用方保持普通用户即可。

退出码
======

  0  成功（干跑即「检查通过」）
  1  参数或环境错误，或阈值预判必然不达标
  2  数据库不可写、schema 不符
  3  构造后事故未出现
  4  撞上结案下限，本轮拒绝写入
  5  片段已到云端，但载荷核对未全通过（sha256 不符、MP4 缺 moov/mdat，
     或缺 SPS/PPS/IDR）
"""

import argparse
import hashlib
import json
import os
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request

# ---- 构造事件的身份标记 -----------------------------------------------------
# event_id 前缀与 source_detail 双标记：前者让 SQL 能按前缀精确扫出构造数据，
# 后者让「这条事件是谁产出的」在事件语义层面也可读。两者必须同时存在——
# 只靠 event_id 前缀的话，归一化器未来改命名规则就扫不到了。
FORGE_EVENT_PREFIX = "forge"
FORGE_SOURCE_DETAIL = "INCIDENT_FORGE"

# ---- 生产表枚举值（必须与 server/src/wireless_event.cpp 的 toString 逐字一致）--
# 这些字符串是本工具与生产代码之间唯一的耦合点。它们一旦漂移，关联器会解析成
# fallback，构造出来的事故会静默消失（而不是报错）。因此集中声明，并由
# --check-schema 在运行时与真实数据比对。
EVENT_TYPE_LINK_DISCONNECTED = "LINK_DISCONNECTED"
EVENT_TYPE_LINK_DEGRADED = "LINK_DEGRADED"
REASON_CONNECTION_TIMEOUT = "CONNECTION_TIMEOUT"
REASON_OTHER = "OTHER"
# REMOTE_USER_TERMINATED 与 LOCAL_HOST_TERMINATED 是计划内断开，绝不构成事故
# （见 QualifyingAnomalyPolicy::isPlannedTermination）。本工具只用上面两类。
SOURCE_KERNEL_HCI_TIMEOUT = "KERNEL_HCI_TIMEOUT"
SOURCE_KERNEL_HCI = "KERNEL_HCI"
PROTOCOL_BLUETOOTH = "BLUETOOTH"
ADDRESS_TYPE_BREDR = "BREDR"
ADDRESS_TYPE_LE_PUBLIC = "LE_PUBLIC"

# ---- 默认参数 ---------------------------------------------------------------
DEFAULT_DB = "/home/radxa/weaknet/data/history.db"
DEFAULT_DEVICES = 3
DEFAULT_COOLDOWN_S = 30
DEFAULT_MONITOR = "bt_events"
DEFAULT_CLI = "/home/radxa/weaknet/client/bin/weaknet-cli"

# 构造事件的时间：现在 - 8 秒。
#
# 为什么要有这个回退量：recoverFromStore 的右边界是插件启动那一刻的墙钟，而
# 写入发生在重启之前。若事件写成「现在」，写入与重启之间那几秒会让它落在边界
# 之外，回放读到 0 条。退 8 秒既能保证远早于重启时刻，又远在 120 秒的回放
# 窗口内部，两头都有余量。
EVENT_BACKDATE_MS = 8 * 1000

# 关联窗口默认 60 秒。同一批事件必须落在同一个窗口内才会被聚成一起事故，因此
# 设备之间的时间偏移必须远小于窗口。
DEVICE_SPREAD_MS = 2000

# 本工具要求的 device_events 最小列集合。列名漂移 = schema 不符 = 拒绝执行，
# 绝不在未知 schema 上盲写（盲写会产出关联器读不懂的行，且不报错）。
REQUIRED_COLUMNS = {
    "event_id", "ts", "site_id", "gateway_id", "protocol", "device_address",
    "address_type", "hci_index", "event_type", "rssi_at_event_dbm",
    "raw_reason_code", "reason", "source", "source_detail", "suspected_cause",
    "details_json",
}


# ============================================================================
# 远端执行抽象
# ============================================================================
class Runner:
    """命令执行器。板端模式下所有命令都经 ssh board 前缀。

    为什么要这层抽象：本工具的主要使用者是云端开发机（板子走反向隧道接入）。
    若工具内部硬编码「本机执行」或「ssh 板子」，就无法在两种场景下复用，
    最终会催生两份几乎相同的脚本。
    """

    def __init__(self, remote, board_alias="board"):
        self.remote = remote
        self.board_alias = board_alias

    def wrap(self, argv):
        if not self.remote:
            return list(argv)
        return ["ssh", self.board_alias] + list(argv)

    def run(self, argv, timeout=60, input_text=None):
        cmd = self.wrap(argv)
        try:
            proc = subprocess.run(
                cmd,
                input=input_text,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
                text=True,
            )
        except FileNotFoundError as exc:
            raise SystemExit("[forge] 找不到可执行文件 %s：%s" % (cmd[0], exc))
        except subprocess.TimeoutExpired:
            raise SystemExit("[forge] 命令超时（%ss）：%s"
                             % (timeout, shlex.join(cmd)))
        return proc.returncode, proc.stdout, proc.stderr

    def run_script(self, script, payload, timeout=120, elevate=False):
        """把一段 Python 代码交给远端 python3 执行，报文内联成模块级常量。

        为什么不走 argv：SQL 与 JSON 含引号、换行与中文，经 ssh 时远端 shell
        会二次解释，迟早出错。为什么不走 stdin 第二条流：python3 接 `-` 时
        stdin 整条都是源码，没有第二条流可用，`readline()` 读到的会是源码
        第一行——这是一个静默出错到 JSON 解析才暴露的坑。

        因此把报文用 repr() 内联进源码：repr 产出的字面量由 Python 自己解析，
        传输层不参与任何内容解释。

        elevate=True 时以 root 身份执行。这不是「为了省事给的权限」，而是写
        history.db 的必要条件：库是 WAL 方言，写事务必须同时拿到 `-wal` 与
        `-shm` 的写权限，而这两个文件由服务端进程持有、属主是 root（服务以
        root 运行，见 `systemctl show weaknet-server -p User`）。以普通用户
        写入会在第一次写事务就被 SQLite 拒绝，报的却是 `attempt to write a
        readonly database`——文件本身可写，是配套文件不可写，这句话极具误导性。

        以 root 写入同时保证了另一件事：全库只有服务端与（临时）本工具两个
        写入者，且两者身份一致，不会出现「同一份 WAL 被两种 uid 交替改写」。
        """
        prelude = "PAYLOAD_JSON = %r\n" % (json.dumps(payload),)
        argv = ["python3", "-"]
        if elevate:
            argv = ["sudo", "-n"] + argv
        return self.run(argv, timeout=timeout, input_text=prelude + script)


# ============================================================================
# 板端 Python 片段（用板端 sqlite3；py3.9 足够，不引入任何额外依赖）
# ============================================================================
# 每个片段都从模块级常量 PAYLOAD_JSON 读参数（由 Runner.run_script 用 repr()
# 内联注入），再把结果作为最后一行 JSON 打印出来。失败也要打印 JSON 而不是抛栈
# ——栈会淹没在 ssh 的 stderr 里，让诊断变成猜谜。

PROBE_SCRIPT = r'''
import json, sqlite3, sys
payload = json.loads(PAYLOAD_JSON)
db = payload["db"]
out = {"ok": False}
try:
    conn = sqlite3.connect("file:" + db + "?mode=ro", uri=True, timeout=5)
except Exception as exc:
    print(json.dumps({"ok": False, "error": "open: %s" % exc})); sys.exit(0)
try:
    cols = [r[1] for r in conn.execute("PRAGMA table_info(device_events)")]
    out["columns"] = cols
    out["has_events_table"] = bool(cols)
    out["event_count"] = conn.execute(
        "SELECT COUNT(*) FROM device_events").fetchone()[0]
    out["incident_count"] = conn.execute(
        "SELECT COUNT(*) FROM site_incidents").fetchone()[0]
    out["forge_event_count"] = conn.execute(
        "SELECT COUNT(*) FROM device_events WHERE event_id LIKE 'forge_%'"
    ).fetchone()[0]
    out["latest_event_ts"] = conn.execute(
        "SELECT MAX(ts) FROM device_events").fetchone()[0] or 0
    out["latest_resolved_at"] = conn.execute(
        "SELECT MAX(resolved_at_ms) FROM site_incidents"
        " WHERE resolved_at_ms IS NOT NULL").fetchone()[0] or 0
    out["ok"] = True
except Exception as exc:
    out["error"] = "query: %s" % exc
finally:
    conn.close()
print(json.dumps(out))
'''

INSERT_SCRIPT = r'''
import json, sqlite3, sys
payload = json.loads(PAYLOAD_JSON)
out = {"ok": False, "inserted": 0, "skipped": 0}
try:
    conn = sqlite3.connect(payload["db"], timeout=10)
    conn.execute("PRAGMA busy_timeout = 10000")
except Exception as exc:
    print(json.dumps({"ok": False, "error": "open: %s" % exc})); sys.exit(0)
try:
    sql = (
        "INSERT OR IGNORE INTO device_events ("
        "event_id, ts, site_id, gateway_id, protocol, device_address,"
        " address_type, hci_index, event_type, rssi_at_event_dbm,"
        " raw_reason_code, reason, source, source_detail, suspected_cause,"
        " details_json) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)"
    )
    rows = payload["rows"]
    before = conn.total_changes
    conn.executemany(sql, rows)
    conn.commit()
    out["inserted"] = conn.total_changes - before
    out["skipped"] = len(rows) - out["inserted"]
    out["ok"] = True
except Exception as exc:
    out["error"] = "insert: %s" % exc
finally:
    conn.close()
print(json.dumps(out))
'''

QUERY_SCRIPT = r'''
import json, sqlite3, sys
payload = json.loads(PAYLOAD_JSON)
out = {"ok": False, "incidents": [], "clips": [], "has_clips_table": False}
try:
