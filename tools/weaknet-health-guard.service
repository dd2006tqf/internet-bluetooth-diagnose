[Unit]
Description=WeakNet System Health Watchdog Guard

# 启动顺序：先让 weaknet-server 起来，再开始喂狗。
#
# 刻意用 Wants 而不是 Requires：weaknet-server 因故障起不来时，守卫
# **必须**照样启动 —— 它看到服务缺席（超过容忍窗口）就会停止喂狗，
# 进而复位板子。这正是「服务该在却没在」时唯一的自动恢复手段。
# 写成 Requires 会让守卫跟着不启动，于是没人喂狗也**没人使能**看门狗，
# 系统就静默退化成一个没有任何保护的状态。
After=weaknet-server.service
Wants=weaknet-server.service

# 依赖 weaknet-ota-gate：守卫的判据依赖服务在线，而服务本身受
# P0-C1 启动门禁约束。若门禁拒绝（救援态 / 状态不可读），服务不会起来，
# 此时守卫打开看门狗只会得到一个必然失败的判据 —— 然后硬件超时复位
# 板子，把「不要启动业务」的明确指令变成「无限重启」。门禁拒绝时必须
# 连守卫一起不启动。
Requires=weaknet-ota-gate.service
After=weaknet-ota-gate.service

[Service]
Type=simple
# 打开 /dev/watchdog 与写入 /var/lib/weaknet 需要 root
User=root
Group=root

# 等设备节点就绪。
#
# 这条路线不加载任何自建模块、不改动驱动绑定，设备由平台驱动 sunxi_wdt
# 在开机 probe 时导出，正常一定存在。保留这个短暂轮询只是为了把
# 「驱动没起来」与「守卫自己打开失败」两种错误在日志里分开，
# 并避免在 devtmpfs 极早期就抢跑失败。
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -c /dev/watchdog0 ] && exit 0; sleep 0.1; done; echo "/dev/watchdog0 不存在，平台看门狗驱动未就绪" >&2; exit 1'

ExecStart=/home/radxa/weaknet/current/client/bin/weaknet-health-guard

# ---- 没有 ExecStopPost 钩子，这是刻意删除的 ----
#
# 旧实现在这里跑一个「归还脚本」（rmmod 自建模块 + bind 回原驱动）。
# 现在驱动全程在线、从未被 unbind，没有需要归还的东西。
#
# 停止语义完全交给设备本身的 MAGICCLOSE 契约，由内核在 release() 里执行：
#   写了 'V'     → ops->stop() → 硬件关闭（优雅停机）
#   没写 'V'     → 拒绝停狗、卸掉代喂 → 硬件超时复位（故障路径）
# 契约在启动时由 VerifyDeviceContract() 硬断言，驱动一旦不支持
# WDIOF_MAGICCLOSE 就拒绝启动，不会静默退化成「停不停都一样」。

# ---- 停止语义：三种情况必须分开处理 ----
#
# 1) 判定不健康 → guard 停止喂狗，退出码 99（kExitTripped）
#    **绝不能重启**：重启会重新 open 设备 → watchdog_start → 使能并喂狗，
#    于是已经排定的复位被静默取消，故障还在而保护没了。
#    guard 自身还有一道 boot_id 标记兜底（防 systemd 配置漂移），
#    这里是第二层。
# （Restart=no 已经排除了自动重启，这条是纵深防御：万一将来有人把
#   Restart 改成 on-failure，退出码 99 依然能挡住。）
RestartPreventExitStatus=99
#
# 2) 正常 stop/restart（systemctl stop、OTA 翻转、ci.sh 部署）
#    guard 收到 SIGTERM 后写 'V' 并 close，主动停用看门狗，不复位。
#    这依赖 systemd 的默认 KillSignal=SIGTERM 与 KillMode=control-group。
KillSignal=SIGTERM
KillMode=control-group
# 给足时间写 'V' 并 close。写 'V' 是在收到信号后的正常退出路径里做的，
# 不是信号处理函数里，因此不会受 async-signal-safety 限制。
TimeoutStopSec=10
#
# 3) guard 自己崩溃（段错误、被 OOM 杀）
#    此时没机会写 'V'，内核代关 fd 后走同一个 release() → 硬件超时复位 ——
#    这是期望行为。但**不要**让 systemd 去重启它：重启会喂狗续命，掩盖崩溃，
#    或者更糟 —— 若崩溃发生在判定失败之后，重启会重新 open 并取消复位。
#    宁可让硬件复位，也不要一个偷偷续命的半死守卫。
Restart=no

# ---- 其他 ----
# /var/lib/weaknet 存放触发标记与失败快照。
# 0755 而非 0700：失败快照的用途就是给运维查看，锁死权限只会让人绕过它。
StateDirectory=weaknet
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
