{
  "schema_version": 1,
  "modules": [
    {
      "id": "weaknet-server",
      "root": ".",
      "adapter": "cmake",
      "cpp_standards": ["c++17"],
      "compilers": ["g++"],
      "target_platforms": ["linux"],
      "path_roles": {
        "production": ["server/src", "server/include", "client"],
        "test": ["server/test"],
        "example": [],
        "generated": ["build-x86", "build-arm64", "dist-arm64"],
        "vendor": [],
        "build_metadata": ["CMakeLists.txt", "server/CMakeLists.txt", "client/CMakeLists.txt"]
      },
      "capabilities": {
        "configure": ["configure-x86"],
        "build": ["build-server"],
        "test": ["test-all"]
      },
      "capability_status": {
        "configure": {"status": "available", "reason": "cmake -B build-x86 configures the x86 local tree with BUILD_EBPF=OFF; measured 8.3s cold"},
        "build": {"status": "available", "reason": "cmake --build build-x86 compiles server, client and 39 gtest targets; measured 5s incremental (5m43s from an empty build directory); requires configure-x86 to have run once"},
        "test": {"status": "available", "reason": "ctest --test-dir build-x86/server --output-on-failure runs the 39 registered x86 gtest suites; measured 5.5s, 39/39 pass"},
        "install": {"status": "needs-approval", "reason": "there are no CMake install() rules: deployment is rsync to the ARM64 board plus systemd, driven by tools/ci.sh, which needs SSH and sudo"},
        "target-run": {"status": "unavailable", "reason": "eBPF attach and Bluetooth need the Radxa Cubie A7A board; the dev host is x86_64 and BUILD_EBPF=OFF skips the probes"},
        "static-analysis": {"status": "needs-approval", "reason": "no static analyzer is configured; the toolchain-probe command only reports the compiler identity"},
        "package": {"status": "not-applicable", "reason": "no packaging step; dist-arm64/ is assembled by tools/ci.sh from build-arm64/"},
        "consumer": {"status": "not-applicable", "reason": "libweaknet.so is consumed out of tree by the ARM64 board deployment, not by an in-repo downstream build"}
      },
      "build_graph_entries": [],
      "distribution_surfaces": []
    }
  ],
  "commands": [
    {
      "id": "configure-x86",
      "module_ids": ["weaknet-server"],
      "capability": "configure",
      "argv": ["cmake", "-B", "build-x86", "-DCMAKE_BUILD_TYPE=Debug", "-DBUILD_EBPF=OFF"],
      "cwd": ".",
      "timeout_seconds": 120,
      "inherit_env": ["PATH", "HOME"],
      "output_roles": [],
      "side_effects": ["workspace-write"],
      "required_tools": ["cmake"]
    },
    {
      "id": "build-server",
      "module_ids": ["weaknet-server"],
      "capability": "build",
      "argv": ["cmake", "--build", "build-x86", "--parallel"],
      "cwd": ".",
      "timeout_seconds": 600,
      "inherit_env": ["PATH", "HOME"],
      "output_roles": [],
      "side_effects": ["workspace-write"],
      "required_tools": ["cmake", "g++"]
    },
    {
      "id": "test-all",
      "module_ids": ["weaknet-server"],
      "capability": "test",
      "argv": ["ctest", "--test-dir", "build-x86/server", "--output-on-failure"],
      "cwd": ".",
      "timeout_seconds": 120,
      "inherit_env": ["PATH", "HOME", "DBUS_SESSION_BUS_ADDRESS"],
      "output_roles": [],
      "side_effects": ["workspace-write"],
      "required_tools": ["ctest"]
    },
    {
      "id": "toolchain-probe",
      "module_ids": ["weaknet-server"],
      "capability": "static-analysis",
      "argv": ["g++", "--version"],
      "cwd": ".",
      "timeout_seconds": 30,
      "inherit_env": ["PATH", "HOME"],
      "output_roles": [],
      "side_effects": [],
      "required_tools": ["g++"]
    }
  ],
  "toolchain_identity": [
    {
      "id": "weaknet-toolchain",
      "module_ids": ["weaknet-server"],
      "command_id": "toolchain-probe"
    }
  ]
}
