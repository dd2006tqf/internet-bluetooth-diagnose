# dev_lite.sh generates this ignored file with mode 0600 and random local values.
M1_RUNTIME_ENV_FILE=.env.m1.local
M1_COMPOSE_PROJECT_NAME=industrial-ops-m1

# Optional host-port overrides; generated runtime and migration credentials remain
# in the ignored 0600 file and are deliberately separated by dev_lite.sh.
M1_WEB_PORT=3000
M1_KEYCLOAK_PORT=8080
M1_MINIO_CONSOLE_PORT=9001

# Optional M7 GraphRAG sidecar. It stays disabled in Compose Lite and is enabled
# by compose.integration.yaml only when a non-placeholder password is supplied.
IOAP_GRAPH_RAG_ENABLED=false
IOAP_NEO4J_PASSWORD=replace-before-enabling
M7_NEO4J_BROWSER_PORT=7474
IOAP_OPENSEARCH_PASSWORD=replace-before-enabling-authenticated-opensearch
M7_OPENSEARCH_PORT=9200
IOAP_KNOWLEDGE_SEARCH_PROFILES_ENABLED=false
IOAP_OPENSEARCH_URL=http://opensearch:9200
IOAP_OPENSEARCH_INDEX_PREFIX=ioap-knowledge
IOAP_RERANKER_INFERENCE_TIMEOUT_SECONDS=5
IOAP_EMBEDDING_INFERENCE_TIMEOUT_SECONDS=10

# FIELD-008 stays fail-closed until a base64-encoded Ed25519 PKCS#8 PEM is
# supplied through the selected SecretProvider. Never commit it to this file.
IOAP_EDGE_DIAGNOSIS_ENABLED=false
IOAP_EDGE_PACK_SIGNING_KEY_ID=field-edge-signing-v1
