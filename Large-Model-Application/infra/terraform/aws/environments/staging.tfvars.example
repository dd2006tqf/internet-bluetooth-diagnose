# Replace every REPLACE_WITH value before an independently reviewed Staging plan.
environment = "staging"
aws_region          = "ap-southeast-1"
allowed_account_ids = ["000000000000"] # REPLACE_WITH_STAGING_ACCOUNT_ID
name_prefix         = "industrial-ops"
owner               = "platform-engineering"
cost_center         = "REPLACE_WITH_COST_CENTER"
data_classification = "confidential"

vpc_cidr                = "10.40.0.0/16"
availability_zones      = ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"]
public_subnet_cidrs     = ["10.40.0.0/24", "10.40.1.0/24", "10.40.2.0/24"]
private_subnet_cidrs    = ["10.40.16.0/20", "10.40.32.0/20", "10.40.48.0/20"]
database_subnet_cidrs   = ["10.40.64.0/24", "10.40.65.0/24", "10.40.66.0/24"]
single_nat_gateway      = true

eks_endpoint_public_access       = false
eks_endpoint_public_access_cidrs = []
eks_admin_principal_arns         = ["arn:aws:iam::000000000000:role/REPLACE_WITH_STAGING_EKS_ADMIN_ROLE"]
kms_admin_principal_arns         = ["arn:aws:iam::000000000000:role/REPLACE_WITH_STAGING_KMS_ADMIN_ROLE"]

cpu_node_group = {
  instance_types = ["m7i.xlarge"]
  min_size       = 1
  desired_size   = 2
  max_size       = 4
  disk_size      = 100
}

inference_gpu_node_group = {
  instance_types = ["g6.xlarge"]
  min_size       = 1
  desired_size   = 1
  max_size       = 2
  disk_size      = 200
}

training_gpu_node_group = {
  instance_types = ["g6.12xlarge"]
  min_size       = 0
  desired_size   = 0
  max_size       = 1
  disk_size      = 500
}

database_instance_class        = "db.r7g.large"
database_allocated_storage     = 100
database_max_allocated_storage = 300
database_multi_az              = false
database_backup_retention_days = 14
database_deletion_protection   = false
database_skip_final_snapshot   = false

artifact_bucket_name = "REPLACE_WITH_STAGING_ARTIFACT_BUCKET"
audit_bucket_name    = "REPLACE_WITH_STAGING_AUDIT_BUCKET"
ecr_repository_names = [
  "industrial-ops/api",
  "industrial-ops/workers",
  "industrial-ops/inference",
]

hosted_zone_id = "ZREPLACEWITHSTAGINGZONE"
gateway_dns_records = {
  api = {
    name    = "api.staging.example.com"
    type    = "CNAME"
    ttl     = 60
    records = ["REPLACE_WITH_STAGING_GATEWAY_LOAD_BALANCER_DNS"]
  }
}
